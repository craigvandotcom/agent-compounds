# Local override of the tracked config.yaml (e.g. your real `humans:` ruling authority) —
# not yet read by close-gate.sh; see the comment in config.yaml.
config.local.yaml

# Database
*.db
*.db-shm
*.db-wal

# Lock files
*.lock

# Temporary
last-touched
*.tmp

# Local history backups (large, transient)
.br_history/

# br 0.2.22+ (FrankenSQLite 0.3 engine) sidecars, migration artefacts and recovery bundles
*-fsqlite-ns-gate
*-fsqlite-ns-use
*-wal-cert
*-wal-cert-head
.beads.db.schema-migration-*
.br_recovery/
*.db-journal
*.fsqlite-migration-state
