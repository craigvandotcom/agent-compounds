__pycache__/
.ruff_cache/
*.pyc
.env
*.egg-info/
dist/
build/

# Plans and research (local only, not shipped)
_plans/

# Agent-local scratch memory — not shared-repo content
.claude/agent-memory/

# Idea inbox — local only, same convention as _plans/
_ideas/

# This machine's local settings file (template: machine.example.json) — absolute paths,
# so it never rides a commit; engine/machine.sh is its only reader
machine.json

# bv (beads viewer) local config and caches
.bv/

# br flush anchor 0.3.0+ — the derived base the three-way merge reads, regenerated per flush
.beads/beads.base.jsonl

# dcg probe payloads — regenerated on every probe run
tools/dcg/fixtures/

# ac-polish run state (round digests + receipt) — scratch; the durable receipt is on the
# beads / plan frontmatter, so this is disposable and must never be committed
.polish/
# ...and the path ac-polish ACTUALLY writes to. The .polish/ rule above states the intent
# ("must never be committed") but never matched, so every polish run left .claude/state/
# showing as untracked and a `git add -A` would have committed it.
.claude/state/

# ---------------------------------------------------------------------------
# Adopter-local content (2026-09-20, agnosticism pass)
#
# This registry is portable engineering doctrine. The artifacts below are each
# DEPLOYMENT's own operational record — one org's frictions, work board, retired
# skills and past review ceremonies. They are not shipped registry content, and
# tracking them published one deployment's specifics (names, hosts, app names,
# absolute paths) in a public repo. Every adopter accumulates their own.
#
# Sensors that read these paths now SKIP when they are absent and stay
# fail-closed when present-but-broken: scripts/ac-ledger-integrity.sh (via
# check 22), check 25-archived-names, check 35-board-integrity.
# ---------------------------------------------------------------------------

# Friction ledgers — each deployment's own operational log
FRICTIONS.md

# The live bead board — each deployment's own work ledger
.beads/issues.jsonl
.beads/.br_recovery/

# Retired skills — local history, not shipped doctrine
_archive/

# Past session artifacts: review ceremonies and swarm run reports
.claude/reviews/
.claude/reports/

# Generated analysis + reports (regenerable; they bake in host and paths)
_docs/seams/
_reports/

# This deployment's banned-word list for 27-instance-tokens: the words that must never
# appear in the published tree (its own app names, org, people, project ids). Local
# because naming them in a public repo is the very thing the check exists to prevent.
# Absent -> the check skips. Template: lint/instance-tokens.example.txt
lint/instance-tokens.local.txt

# Machine-written workflow run receipts. The nightly scheduler rewrites these with
# the live host, app scope, pushed SHA and notification channel — so a tracked one
# re-leaks on every run. scope.py already classes them as STATE, not doctrine.
skills/*/workflows/last-run.json
